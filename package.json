{
  "name": "majestic-creations",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=24.0.0 <25.0.0"
  },
  "scripts": {
    "postinstall": "patch-package",
    "predev": "node scripts/build-blog.mjs",
    "dev": "vinext dev",
    "prebuild": "node scripts/build-blog.mjs",
    "build": "vinext build",
    "images:optimize": "node scripts/optimize-site-images.mjs",
    "images:check": "node scripts/optimize-site-images.mjs --check",
    "blog:check": "node scripts/build-blog.mjs",
    "releases:sync": "node scripts/sync-work-day-with-god-releases.mjs",
    "portfolio:releases:sync": "node scripts/sync-portfolio-releases.mjs",
    "scripture:check": "node scripts/build-scripture-verses.mjs",
    "build:pages": "node scripts/optimize-site-images.mjs --check && node scripts/build-scripture-verses.mjs && node scripts/build-blog.mjs && node scripts/sync-work-day-with-god-releases.mjs && node scripts/sync-portfolio-releases.mjs && vinext build && node scripts/export-pages.mjs && node scripts/verify-pages-export.mjs",
    "pages:verify": "node scripts/verify-pages-export.mjs",
    "start": "vinext start",
    "test": "npm run build && node --test tests/rendered-html.test.mjs",
    "lint": "eslint . --ignore-pattern dist --ignore-pattern .next",
    "db:generate": "drizzle-kit generate"
  },
  "dependencies": {
    "drizzle-orm": "0.45.2",
    "gray-matter": "^4.0.3",
    "marked": "^16.4.1",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.67.0",
    "@cloudflare/workers-types": "5.20261101.1",
    "@eslint/js": "9.39.5",
    "@next/eslint-plugin-next": "16.2.6",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "24.13.3",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.38",
    "drizzle-kit": "0.31.11",
    "eslint": "9.39.5",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "eslint-plugin-react": "7.37.5",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "16.4.0",
    "patch-package": "8.0.1",
    "react-server-dom-webpack": "19.3.1",
    "sharp": "0.35.5",
    "tailwindcss": "4.2.1",
    "typescript": "5.9.3",
    "typescript-eslint": "8.72.1",
    "vinext": "1.4.1",
    "vite": "8.3.5",
    "wrangler": "4.156.1"
  },
  "overrides": {
    "@esbuild-kit/esm-loader": {
      "@esbuild-kit/core-utils": {
        "esbuild": "0.25.12"
      }
    },
    "fflate": "0.7.5",
    "minimatch": "11.0.1"
  },
  "type": "module"
}
